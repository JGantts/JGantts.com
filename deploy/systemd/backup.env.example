# Install as /etc/jgantts-com/backup.env with mode 0600 and root ownership.
RESTIC_REPOSITORY=s3:https://replace-on-server.example/jgantts-backups
RESTIC_PASSWORD=replace-on-server
AWS_ACCESS_KEY_ID=replace-on-server
AWS_SECRET_ACCESS_KEY=replace-on-server
OPERATIONS_ALERT_WEBHOOK=https://replace-on-server.example/operations-alert
