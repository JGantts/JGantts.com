# Install as /etc/jgantts-com/jgantts-com.env with mode 0640. Do not commit values.
PORT=8888
SITE_ORIGIN=https://jgantts.com
JGANTTS_DATA_ROOT=/var/lib/jgantts
JGANTTS_ADMIN_TOKEN=replace-on-server
MASTODON_BASE_URL=https://replace-on-server.example
MASTODON_ACCESS_TOKEN=replace-on-server

# Web Push: keep sending disabled until canary/device verification is complete.
JGANTTS_PUSH_ENABLED=false
JGANTTS_PUSH_SEND_ENABLED=false
# Empty = nobody, comma-separated installation UUIDs = canaries, * = public.
JGANTTS_PUSH_AUDIENCE=
JGANTTS_PUSH_VAPID_PUBLIC_KEY=
JGANTTS_PUSH_VAPID_PRIVATE_KEY=
JGANTTS_PUSH_VAPID_SUBJECT=mailto:contact@jgantts.com
# Optional JSON array of old VAPID key pairs during rotation; contains secrets.
JGANTTS_PUSH_PREVIOUS_KEYS=
