[Unit]
Description=Verify an isolated restore from off-host JGantts backup
After=network-online.target
OnFailure=jgantts-operations-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/jgantts-com/backup.env
ExecStart=/usr/local/libexec/jgantts/restore-rehearsal.sh --data-root /var/lib/jgantts --release-root /home/jgantts-com/node-js
User=root
PrivateTmp=true
NoNewPrivileges=true
