{
  "name": "jgantts-server",
  "version": "1.0.0",
  "description": "JGantts site",
  "private": true,
  "main": "dist/server.js",
  "author": "JGantts",
  "license": "none",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/write-build-info.js",
    "check": "node --check serve.js && node --check scripts/smoke-test.js && node --check scripts/write-build-info.js && npm run typecheck && npm test",
    "content:backup": "node dist/cli/backup-content.js",
    "dev": "tsx watch src/server.ts",
    "smoke": "npm run build && node scripts/smoke-test.js",
    "smoke:live": "node scripts/smoke-test.js --live",
    "smoke:local": "npm run build && node scripts/smoke-test.js --local",
    "start": "node dist/server.js",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "marked": "^18.0.11",
    "multer": "^2.3.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "express",
    "node",
    "server"
  ]
}
